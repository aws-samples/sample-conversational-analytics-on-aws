# Conversational Analytics Environment Configuration
# Copy this file to .env.<username> (e.g., .env.dev)
# and fill in your AWS account details.

# AWS Account Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-west-1

# QuickSight Configuration
QUICKSIGHT_USER_ARN=arn:aws:quicksight:eu-west-1:123456789012:user/default/your-username
QUICKSIGHT_NAMESPACE=default

# S3 Configuration
S3_BUCKET_PREFIX=conversational-analytics

# Additional QuickSight users to add to the conversational-analytics-demo group (comma-separated)
# Supports both native QuickSight users (email) and IAM-federated users (namespace/email)
# QUICKSIGHT_ADDITIONAL_USERS=user1@example.com,user2@example.com